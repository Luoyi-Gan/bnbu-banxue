# Separate read-only account for the existing sports database.
# Never use this URL as DATABASE_URL or as a migration/import destination.
BNBU_SPORTS_SOURCE_DATABASE_URL=postgresql://sports_reader:REPLACE_LOCALLY@HOST:5432/SPORTS_DATABASE
