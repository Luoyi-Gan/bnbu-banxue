    "still": "remotion still src/index.ts BanxueLaunch",
    "capture": "node capture/capture.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.484",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.484"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "playwright": "1.61.1",
    "typescript": "6.0.3"
  }
}
