{
  "name": "bnbu-banxue-launch-video",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts BanxueLaunch out/banxue-launch.mp4",
    "render:nobgm": "remotion render src/index.ts BanxueLaunch out/banxue-launch-nobgm.mp4 --props=props-nobgm.json",
